# Anthropic API key for the server-side AI surface (POST /api/ai/edit).
# Local dev: loaded via `infisical run --env=dev -- pnpm dev`.
# Prod: set in Coolify (sourced from Infisical, env=prod).
ANTHROPIC_API_KEY=

# Optional. One of: HAIKU | SONNET. Defaults to HAIKU.
# Sonnet escalation is normally explicit at the call site; this is the
# fallback for routes that don't pin a model.
AI_DEFAULT_MODEL=HAIKU

# Reserved for Phase 2 ops. Not enforced in Wave 1.
AI_DAILY_TOKEN_CAP=

# --- Auth-Brain (identity + authorization) ---
# framer-clone owns NO identity: sessions and the workspace membership graph
# live in auth-brain. These wire the consuming-app SDK + middleware.
# Local dev: loaded via `infisical run --env=dev -- pnpm dev`.
# Prod: injected by Coolify from Infisical (env=prod).

# Base URL of the auth-brain service. The session-verify endpoint and the login
# page (where the middleware bounces unauthenticated authoring traffic) both
# live here. Optional: defaults to https://auth.lumitra.co so `next build` and
# local dev work without it set.
AUTH_BRAIN_URL=https://auth.lumitra.co

# The fixed lumitra-owned host that serves the EDITOR (e.g. app.lumitra.co). The
# middleware uses it as the root-routing discriminator: on this host (or
# localhost / 127.0.0.1) `/` is the editor; on ANY other host `/` is rewritten to
# the published storefront home. Leave UNSET in dev so `/` stays the editor and
# local dev is unchanged. Just a hostname (no scheme, no port); not a secret.
EDITOR_HOST=

# OpenFGA endpoint + store that back the per-resource `can()` permission checks
# (workspace.viewer / workspace.admin). Required for authorization to resolve;
# when unset, `can()` throws and every guarded check fails CLOSED (denies).
OPENFGA_API_URL=
OPENFGA_STORE_ID=

# Postgres connection string. Used by Prisma (CMS + commerce engines today;
# site persistence in a later phase). `next build` does not need a live value.
DATABASE_URL=
