# Anthropic API key for the server-side AI surface (POST /api/ai/edit).
# Local dev: loaded via `infisical run --env=dev -- pnpm dev`.
# Prod: set in Coolify (sourced from Infisical, env=prod).
ANTHROPIC_API_KEY=

# Optional. One of: HAIKU | SONNET. Defaults to HAIKU.
# Sonnet escalation is normally explicit at the call site; this is the
# fallback for routes that don't pin a model.
AI_DEFAULT_MODEL=HAIKU

# Reserved for Phase 2 ops. Not enforced in Wave 1.
AI_DAILY_TOKEN_CAP=
# The Books upload import of past invoices (docs/plans/2026-10-20-books-upload-import.md):
# the model that reads each uploaded invoice PDF (a model id; default claude-sonnet-5-5,
# an unknown id is refused, never replaced), and the invoices read per company in a rolling
# 24 hours (default 500).
AI_INVOICE_EXTRACT_MODEL=
BOOKS_IMPORT_DAILY_LIMIT=

# Unsplash access key for the page generator's stock photos (server-side only,
# never sent to the browser). Lives in framer-clone's Infisical project (dev and
# prod); leave empty here. Unset: stock photos are off, generated images keep
# the placeholder and the Generate dialog says so.
UNSPLASH_ACCESS_KEY=
# Optional. The application name sent as utm_source in the photographer and
# Unsplash credit links (Unsplash API guidelines). Should match the app name
# registered at unsplash.com/developers. Defaults to "lumitra".
UNSPLASH_APP_NAME=

# --- Auth-Brain (identity + authorization) ---
# framer-clone owns NO identity: sessions and the workspace membership graph
# live in auth-brain. These wire the consuming-app SDK + middleware.
# Local dev: loaded via `infisical run --env=dev -- pnpm dev`.
# Prod: injected by Coolify from Infisical (env=prod).

# Base URL of the auth-brain service. The session-verify endpoint and the login
# page (where the middleware bounces unauthenticated authoring traffic) both
# live here. Optional: defaults to https://auth.lumitra.co so `next build` and
# local dev work without it set.
AUTH_BRAIN_URL=https://auth.lumitra.co

# The host that serves the EDITOR (production: app.lumitra.co). The middleware
# uses it as the root-routing discriminator: on this host (or localhost /
# 127.0.0.1) `/` is the editor; on ANY other host `/` is rewritten to the
# published site's home. Leave UNSET in dev so `/` stays the editor. Just a
# hostname (no scheme, no port); not a secret. See deploy/README.md.
# Production refuses to start without it (NODE_ENV=production + empty value).
EDITOR_HOST=

# OpenFGA endpoint + store that back the per-resource `can()` permission checks
# (workspace.viewer / workspace.admin). Required for authorization to resolve;
# when unset, `can()` throws and every guarded route answers 503
# `authz_unavailable` (never a grant).
OPENFGA_API_URL=
OPENFGA_STORE_ID=
# The pre-shared key of an OpenFGA that runs with preshared auth (the suite's
# does: without it every check is a 401). Leave empty for a local OpenFGA that
# runs without a key; the server warns at start when the URL is set and this
# is not. Secret: lives in Infisical, never here.
OPENFGA_API_TOKEN=
# Optional: pin checks to one authorization model id instead of the store's
# latest model. Not a secret.
OPENFGA_AUTHORIZATION_MODEL_ID=

# The parent domain of published sites (production: sites.lumitra.co). A request
# to <label>.sites.lumitra.co serves the published site whose SiteDomain
# subdomain is <label>. Unset: the first label of any 3+ label host is used.
PUBLIC_SITE_BASE_HOST=

# Postgres connection string of the database's bootstrap user. Used by Prisma
# (sites, CMS, data tables) and by `prisma migrate deploy` at container start.
# `next build` does not need a live value.
DATABASE_URL=

# The commerce engine's two roles on the same database (see
# prisma/sql/commerce-roles.sql and deploy/README.md). Both required in
# production; the container start fails without the owner URL.
#   COMMERCE_APP_DATABASE_URL: the low-privilege commerce_app role, every
#     commerce read and write at runtime (default search_path must be ext).
#   COMMERCE_OWNER_DATABASE_URL: the owner role commerce_ddl, the commerce
#     migrations at container start and a company's first-project provisioning
#     (never a superuser, and without CREATEROLE: both refused at start).
COMMERCE_APP_DATABASE_URL=
COMMERCE_OWNER_DATABASE_URL=

# --- Analytics (Lumitra tracker injection into published pages) ---
# A published site emits analytics ONLY when its `lumitraEnabled` flag is set AND
# a PUBLIC ingestion key + endpoint resolve AND the tracker loader URL is set.
# The key is PUBLIC by design (the `ap_live_` ingestion key, safe to ship in
# HTML); a secret-shaped value is REFUSED by the build backstop. Never put a
# secret/account key here.
#
# The PUBLIC ingestion key (ap_live_...). The published page resolves it from the
# per-site apiKeyRef-named env var first, then this shared fallback. The REAL key
# is minted via the auth-brain machine API (not yet merged/deployed); leave the
# placeholder until then.
ANALYTICS_PUBLIC_INGESTION_KEY=ap_live_PLACEHOLDER_REPLACE_ME

# The analytics ingestion endpoint (where events are POSTed). Falls back here when
# the site row does not carry one, so the demo site is env-configurable.
ANALYTICS_INGESTION_ENDPOINT=https://ingest.lumitra.co

# The tracker LOADER script URL. Published pages never contain it: the consent
# banner (src/lib/consent/consent.ts) injects it, with window.__AP_CONFIG and
# window.__AP_VARIANTS, only after the visitor accepts; declining loads nothing.
# Contract for the loader: read window.__AP_CONFIG (it carries consent:
# {analytics:true}), or listen for the lumitra:consent event, and expose
# window.LumitraAnalytics.enableTracking() to turn on clicks and scroll (it is
# called on load). Without this URL accepting only sets the config globals.
ANALYTICS_TRACKER_SCRIPT_URL=https://cdn.lumitra.co/tracker.js

# Optional analytics project id, tagged onto emitted events. Falls back here when
# the site row does not carry one.
ANALYTICS_PROJECT_ID=

# --- The Books (invoicing) ---
# The shared contacts database of the suite: the Books read a recipient's name
# and address from it (@marlinjai/contacts-core). Copied from the receipts
# project in Infisical, never typed. Unset: issuing answers RECIPIENT_UNAVAILABLE.
CONTACTS_DATABASE_URL=
# The auth-brain admin machine key, used only by `pnpm books:init-company` to
# read the company's legal name, VAT id and billing address.
AUTH_BRAIN_ADMIN_API_KEY=
