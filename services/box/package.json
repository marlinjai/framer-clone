{
  "name": "framer-clone-box",
  "version": "0.1.0",
  "private": true,
  "description": "Serves sandboxed custom code documents from their own registrable domain. Connected to nothing yet.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --log-level=warning --outfile=dist/box.cjs"
  },
  "dependencies": {
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@types/node": "22.20.5",
    "esbuild": "0.28.1",
    "eslint": "9.39.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.1.12"
  }
}
