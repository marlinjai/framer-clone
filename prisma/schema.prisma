// prisma/schema.prisma
//
// framer-clone backend foundation (Track 0). One PrismaClient serves the CMS
// engine (the dt_* models below), the site persistence models and the agent
// run log. Commerce does not use Prisma: see the datasource comment below.
//
// The 8 dt_* models are copied verbatim from
//   data-table/packages/adapter-prisma/prisma/schema.prisma
// so the single generated client also serves the adapter-prisma repo that
// slice2-cms-server-adapter-and-repo wires in later.
//
// DATABASE_URL is injected via Infisical / Coolify, never a .env file and
// never a literal. The singleton in src/server/db.ts reads it lazily, so a
// placeholder value is enough for `next build`.

generator client {
  provider      = "prisma-client-js"
  // Runtime is node:22-bookworm-slim (Debian 12, openssl 3.0.x) on linux/arm64.
  // Pin the engine target explicitly so the generated client always carries the
  // matching query engine, even if the builder mis-detects openssl. "native"
  // keeps local dev working.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

// Prisma manages ONE schema: `public` (the CMS dt_* models, sites, agent runs).
//
// Commerce is NOT here any more (CM-13 of
// docs/plans/2026-06-27-commerce-tenant-db-migration-plan.md). Every company's
// commerce data lives in its own `tg_<hex32>` Postgres schema, created and
// migrated by @marlinjai/tenant-db from src/server/commerce/migrations/tenant
// and read and written through Kysely (src/server/commerce/db.ts). The 19
// commerce models and 9 enums that used to sit at the bottom of this file, in
// the shared `commerce` schema, were removed together with the Prisma commerce
// code path.
//
// The historical migrations that created the shared `commerce` schema
// (20260616120000 to 20260616160000) stay in prisma/migrations on purpose: a
// database that already holds commerce rows keeps them until
// src/server/commerce/provisioning/backfill-demo.ts has copied them into the
// company's tg_<hex32> schema, and no migration drops that schema blindly.
// Because `commerce` is no longer listed in `schemas` below, Prisma neither
// reads nor diffs it, so `prisma migrate dev` does not propose dropping it.
// Dropping it is a separate, explicit operator step (see the plan, section 9).
//
// multiSchema stays on (with `public` as the only entry) so the @@schema
// attributes on the remaining models keep their meaning unchanged.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model DtTable {
  id          String     @id @default(uuid())
  workspaceId String     @map("workspace_id")
  name        String
  description String?
  icon        String?
  migrated    Boolean    @default(false)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  columns     DtColumn[]
  views       DtView[]

  @@map("dt_tables")
  @@schema("public")
}

model DtColumn {
  id        String   @id @default(uuid())
  tableId   String   @map("table_id")
  name      String
  type      String
  position  Int
  width     Int      @default(200)
  isPrimary Boolean  @default(false) @map("is_primary")
  config    Json?
  alignment String?
  createdAt DateTime @default(now()) @map("created_at")
  table     DtTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("dt_columns")
  @@schema("public")
}

model SelectOption {
  id       String  @id @default(uuid())
  columnId String  @map("column_id")
  name     String
  color    String?
  position Int

  @@map("select_options")
  @@schema("public")
}

model DtRowSelectValue {
  id       String @id @default(uuid())
  rowId    String @map("row_id")
  columnId String @map("column_id")
  optionId String @map("option_id")

  @@unique([rowId, columnId, optionId])
  @@map("dt_row_select_values")
  @@schema("public")
}

model DtRelation {
  id             String   @id @default(uuid())
  sourceRowId    String   @map("source_row_id")
  sourceColumnId String   @map("source_column_id")
  targetRowId    String   @map("target_row_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([sourceRowId, sourceColumnId, targetRowId])
  @@map("dt_relations")
  @@schema("public")
}

model DtFile {
  id           String @id @default(uuid())
  rowId        String @map("row_id")
  columnId     String @map("column_id")
  fileId       String @map("file_id")
  fileUrl      String @map("file_url")
  originalName String @map("original_name")
  mimeType     String @map("mime_type")
  sizeBytes    Int?   @map("size_bytes")
  position     Int    @default(0)
  metadata     Json?

  @@map("dt_files")
  @@schema("public")
}

model DtView {
  id        String   @id @default(uuid())
  tableId   String   @map("table_id")
  name      String
  type      String   @default("table")
  isDefault Boolean  @default(false) @map("is_default")
  position  Int      @default(0)
  config    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  table     DtTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("dt_views")
  @@schema("public")
}

// Legacy table: kept during the migration transition period
model DtRow {
  id        String  @id @default(uuid())
  tableId   String  @map("table_id")
  cells     Json?
  computed  Json?
  title     String? @map("_title")
  archived  Int     @default(0) @map("_archived")
  createdAt String  @map("_created_at")
  updatedAt String  @map("_updated_at")

  @@map("dt_rows")
  @@schema("public")
}

// ===========================================================================
// Site persistence (P1b): the multi-tenant source of truth for the visual
// editor. Today the ProjectModel/PageModel MST tree lives only in browser
// memory; these four tables make Prisma the source of truth and the MST a
// working copy that is snapshotted in (load) and out (save).
//
// HARD ISOLATION BOUNDARY: every table here carries BOTH `workspace_id` AND
// `tenant_group_id`, and BOTH are indexed. workspace_id is the per-request
// scope every editor/API query filters by (the auth-brain consuming-app
// contract: the caller's session yields a workspace, never cross-workspace
// data). tenant_group_id is the coarser isolation boundary that keeps the
// B2B2C door open: a site can later be promoted to its own tenant_group
// without a schema change, and a tenant_group-wide query (export, deletion,
// billing) is index-backed. Neither column is a foreign key into this app:
// the tenant_group -> tenant -> workspace hierarchy is owned by auth-brain,
// framer-clone models NO identity (no users/memberships table). These ids are
// resolved from the verified session and stamped onto each row.
//
// One framer-clone "project" (a ProjectModel) == one `Site` row. Each MST
// page (PageModel) == one `SitePage` row whose `snapshot` JSON is the full
// PageModel SnapshotOut. The Lumitra Analytics binding (LumitraBindingModel)
// is denormalised onto the Site row so a publish-path read needs no JSON
// parse to find the analytics project/ingestion-key reference.
// ===========================================================================

enum SiteStatus {
  draft
  published
  archived

  @@schema("public")
}

/// `active` doubles as the state of a platform subdomain row (always active).
/// A custom hostname walks pending -> verified (DNS ownership and routing
/// proven, served over HTTP, certificate being issued) -> active (a valid
/// certificate answers for it); `failed` carries the reason in `last_error`.
enum DomainVerificationStatus {
  pending
  active
  failed
  verified

  @@schema("public")
}

/// How a revision came to be: a `publish`, or the `baseline` that froze what a
/// site published before revisions existed was serving (see SiteRevision).
enum SiteRevisionKind {
  publish
  baseline

  @@schema("public")
}

enum SiteExperimentStatus {
  draft
  running
  paused
  completed

  @@schema("public")
}

/// A persisted framer-clone site == one ProjectModel. The MST tree is the
/// editor working copy; this row plus its `pages` is the source of truth.
model Site {
  id String @id @default(uuid())

  // --- hard isolation boundary (both indexed) ---
  workspaceId   String @map("workspace_id")
  tenantGroupId String @map("tenant_group_id")

  // --- ProjectModel.metadata snapshot ---
  name        String
  description String     @default("")
  status      SiteStatus @default(draft)

  // --- LumitraBindingModel snapshot (denormalised for the publish path) ---
  // analyticsProjectId / ingestionEndpoint / apiKeyRef mirror the MST
  // `lumitra` sub-tree. apiKeyRef is a SERVER-SIDE reference (Infisical path /
  // workspace-scoped pointer), NEVER the literal ap_live_ key. lumitraEnabled
  // gates snippet injection on publish.
  analyticsProjectId String? @map("analytics_project_id")
  ingestionEndpoint  String? @map("ingestion_endpoint")
  apiKeyRef          String? @map("api_key_ref")
  lumitraEnabled     Boolean @default(false) @map("lumitra_enabled")

  // ProjectModel.metadata timestamps are APPLICATION-meaningful (the user's
  // "created" / "last edited" shown in the UI), distinct from the row
  // timestamps below which track the persistence layer. Persisted explicitly
  // so a load -> save round-trip preserves them instead of resetting them via
  // the MST `() => new Date()` factory.
  projectCreatedAt DateTime @map("project_created_at")
  projectUpdatedAt DateTime @map("project_updated_at")

  // Old-slug redirects (src/lib/pages/redirects.ts): a JSON list of
  // { from, pageId, createdAt }. Maintained by SiteRepository.saveProject when
  // a page of an ever-published site changes its slug; the published router
  // answers `from` with a 308 to the page's current path. Capped, never chained.
  redirects Json @default("[]")

  // Site settings (src/lib/site/siteSettings.ts): site name, language,
  // favicon, Open Graph defaults, title template, 404 page, business data. One
  // JSON object mirroring ProjectModel.siteSettings; always read through
  // normalizeSiteSettings, so a new field needs no migration.
  siteSettings Json @default("{}") @map("site_settings")

  // Reusable component definitions by id (docs/plans/2026-11-02-reusable-components.md): a JSON object
  // mirroring ProjectModel.components, saved in one transaction with the pages that place them. Always read
  // through parseComponents, because stored JSON can say anything. A save that sends no `components` key
  // leaves it alone: only a tab from before this column sends none.
  components Json @default("{}")

  // The auth-brain company the site belongs to (docs/plans/2026-10-25-catalogue-design.md): the storefront
  // has no session, so the catalogue reads of a published site find the company here. Stamped at creation
  // and whenever a signed-in member of the company opens the site in the editor; NULL only for a site
  // created before this column and not opened since (the storefront then falls back to the tenant group's
  // sole company, src/server/commerce/storefrontTenant.ts).
  companyId String? @map("company_id")

  // The revision visitors are served (docs/plans/2026-11-01-immutable-published-copy.md). NULL for a site
  // that has none yet: never published, or published before revisions existed, in which case the public
  // resolver serves the working copy until the first save or publish freezes it. NO ACTION, not SET NULL:
  // losing a live revision must fail loudly, never fall through to serving drafts. It is checked at the end
  // of the statement, so the cascade from deleting the site passes.
  publishedRevisionId String?       @map("published_revision_id")
  publishedRevision   SiteRevision? @relation("SitePublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: NoAction)

  // Raised by one on every erase of personal data (the plan's "Erasing personal data from the history"). An
  // editor tab sends the value it loaded with each Save and Publish, and an older one is refused, so a tab
  // opened before an erase cannot write the erased value back.
  erasureEpoch Int @default(0) @map("erasure_epoch")

  // The version lock: raised by one on every write of the working copy (save, publish, an erase of personal
  // data). A save or publish names the version it was based on (`expectedVersion`), and a different stored
  // number refuses it with 409 `site_changed`, so an editor tab and an agent never overwrite each other
  // unseen. Rename, rollback and unpublish leave it alone: none of them writes what a save writes.
  version Int @default(1)

  // The key the editor named its last write of the working copy with (save only; publish and
  // erase clear it). A retry of that attempt after a lost answer, still based on the version just
  // before it, gets this write's version back instead of a false 409 `site_changed`. Lives exactly
  // until the next write of the site.
  lastWriteKey     String? @map("last_write_key")
  // The version the write named by `lastWriteKey` produced. The key counts only while this equals
  // `version`: a writer that does not know the key (an older container during a rolling deploy)
  // moves the version and leaves the key, and that unbinds it.
  lastWriteVersion Int?    @map("last_write_version")

  // Site branches (docs/plans/2026-11-10-site-branches.md): the main site this row is a hidden branch of, or
  // NULL for a main site (every site that existed before branches). Set once at creation and never changed (a
  // trigger refuses an update). The composite foreign key with `workspace_id` makes a branch of another
  // workspace's site impossible, and deleting a main site deletes its branches. Raw SQL in the migration adds
  // what Prisma cannot say: a branch is never published nor live, never a branch of a branch, and holds no domain.
  branchOfSiteId String?      @map("branch_of_site_id")
  branchOf       Site?        @relation("SiteBranchContent", fields: [branchOfSiteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  branchSites    Site[]       @relation("SiteBranchContent")
  // The branch records of this main site, and (for a hidden branch row) the one record naming it.
  branchRecords  SiteBranch[] @relation("SiteBranchMain")
  branchRecord   SiteBranch?  @relation("SiteBranchRow")

  // Persistence-layer timestamps (when the ROW was written), set by the DB.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pages       SitePage[]
  domains     SiteDomain[]
  experiments SiteExperiment[]
  cspReports  CspReportCount[]
  revisions   SiteRevision[]   @relation("SiteRevisions")
  images      SiteImage[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([tenantGroupId])
  // Deleting a revision makes the foreign key check look here.
  @@index([publishedRevisionId])
  // Listing a site's branches, and the cascade from deleting a main site.
  @@index([branchOfSiteId])
  @@map("sites")
  @@schema("public")
}

/// The record of one site branch (docs/plans/2026-11-10-site-branches.md, section 4). Its `id` is the id of the
/// hidden `sites` row holding the branch's content, with no foreign key to it, so the record outlives that row:
/// once the branch is merged or discarded the row is deleted, `branch_site_id` is NULL and the record keeps the
/// branch's address answering "closed". `base_document` is main's working copy at the fork (or at the last update
/// from main), in the revision document format: the common ancestor of the three-way merge.
model SiteBranch {
  id String @id

  // The main site. Deleting it deletes its branch records.
  siteId String @map("site_id")

  // --- hard isolation boundary (both indexed), copied from the main site ---
  workspaceId   String  @map("workspace_id")
  tenantGroupId String  @map("tenant_group_id")
  companyId     String? @map("company_id")

  // The hidden `sites` row holding the content while the branch is open or ready; NULL once closed.
  branchSiteId String? @unique @map("branch_site_id")

  name   String
  status SiteBranchStatus @default(open)

  baseVersion  Int?  @map("base_version")
  baseDocument Json? @map("base_document")

  // The review in progress: conflict answers keyed to the values they were given for (S3, S5).
  mergeDraft Json? @map("merge_draft")

  readyBy               String?   @map("ready_by")
  readyAt               DateTime? @map("ready_at")
  reviewNote            String?   @map("review_note")
  approvedBy            String?   @map("approved_by")
  approvedAt            DateTime? @map("approved_at")
  approvedBranchVersion Int?      @map("approved_branch_version")

  mergedBy          String?   @map("merged_by")
  mergedAt          DateTime? @map("merged_at")
  mergedFromVersion Int?      @map("merged_from_version")
  mergedMainVersion Int?      @map("merged_main_version")
  discardedBy       String?   @map("discarded_by")
  discardedAt       DateTime? @map("discarded_at")

  // Main as it was just before this branch's merge, for "Undo this merge" (S7): only the site's latest merge keeps one.
  mainBeforeDocument  Json?     @map("main_before_document")
  mainBeforeExpiresAt DateTime? @map("main_before_expires_at")
  // Why that copy went without an undo: `expired`, `replaced` (a later merge) or `erased` (an erase of personal
  // data left a match in it and removed it). Null while the copy is kept, and on records that never had one.
  mainBeforeEnded     String?   @map("main_before_ended")

  // Set when this branch's merge was undone (S7): the new open branch that took the merged work, who, and when.
  // No foreign key: the new branch has its own life (merged again, discarded), and this stays as what happened.
  undoneIntoBranchId String?   @map("undone_into_branch_id")
  undoneBy           String?   @map("undone_by")
  undoneAt           DateTime? @map("undone_at")

  // Who made it: a signed-in person (`user`) or an MCP key (`key`), as site_operation_audits records actors.
  createdByKind String   @map("created_by_kind")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Composite, as on `sites.branch_of_site_id`: a record of another workspace's site cannot exist.
  site       Site  @relation("SiteBranchMain", fields: [siteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  // SET NULL: whatever deletes the content row, the record reads as closed rather than pointing at nothing.
  branchSite Site? @relation("SiteBranchRow", fields: [branchSiteId], references: [id], onDelete: SetNull)

  // The public preview link (S8), at most one per branch.
  preview SiteBranchPreview?

  // For the composite foreign key of `site_branch_previews`.
  @@unique([id, workspaceId])
  @@index([siteId])
  @@index([workspaceId])
  @@index([tenantGroupId])
  @@map("site_branches")
  @@schema("public")
}

// The public preview link of a branch (S8): `preview-<token>.<sites base host>` shows the branch's working copy,
// read only, to anyone who holds the address. Only a SHA-256 of the token is stored. A new link replaces the row,
// revoking deletes it, closing or deleting the branch takes it along.
model SiteBranchPreview {
  id       String @id
  branchId String @unique @map("branch_id")

  // --- hard isolation boundary (both indexed), copied from the branch ---
  workspaceId   String  @map("workspace_id")
  tenantGroupId String  @map("tenant_group_id")
  companyId     String? @map("company_id")

  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  // Composite: a link of another workspace's branch cannot exist.
  branch SiteBranch @relation(fields: [branchId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  // What Prisma asks of a one-to-one relation over two columns; `branchId` alone is already unique.
  @@unique([branchId, workspaceId])
  @@index([workspaceId])
  @@index([tenantGroupId])
  @@map("site_branch_previews")
  @@schema("public")
}

enum SiteBranchStatus {
  open
  ready
  merged
  discarded

  @@schema("public")
}

/// One uploaded site image (favicon or sharing image, src/lib/site/siteImages.ts): the checked bytes, stored once
/// per site and SHA-256, named in the settings by `/site-images/<sha256>.<ext>` and served on the site's own hosts
/// (src/app/site-images/[file]/route.ts). Never updated; deleted only once nothing names it (no setting, no page,
/// no kept revision, which freezes the path). Deleting the site deletes its images.
model SiteImage {
  id String @id @default(uuid())

  siteId String @map("site_id")

  // --- hard isolation boundary (both indexed), denormalised from the Site ---
  workspaceId   String @map("workspace_id")
  tenantGroupId String @map("tenant_group_id")

  sha256      String
  // Read from the bytes, never from the request: image/png, image/jpeg, image/webp or image/x-icon.
  contentType String @map("content_type")
  byteSize    Int    @map("byte_size")
  width       Int
  height      Int
  content     Bytes

  // The auth-brain user who uploaded it first.
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, sha256])
  @@index([workspaceId])
  @@index([tenantGroupId])
  @@map("site_images")
  @@schema("public")
}

/// One serialized PageModel. `snapshot` is the full PageModel SnapshotOut
/// (metadata + appComponentTree + canvasNodes), the unit the MST loads from /
/// saves to. `pageId` is the MST page identifier (stable across saves);
/// `slug` is mirrored out of the snapshot so the publish/router layer can
/// resolve a page by URL without parsing the JSON.
model SitePage {
  id String @id @default(uuid())

  siteId String @map("site_id")

  // --- hard isolation boundary (both indexed), denormalised from the Site ---
  workspaceId   String @map("workspace_id")
  tenantGroupId String @map("tenant_group_id")

  // MST PageModel.id (the `types.identifier`). Unique within a site so a
  // save can upsert per page rather than delete-and-recreate.
  pageId String @map("page_id")
  slug   String

  // Full PageModel SnapshotOut. Json (not Jsonb-via-bytes) so it stays
  // human-readable in psql and the page tree round-trips losslessly.
  snapshot Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, pageId])
  @@index([workspaceId])
  @@index([tenantGroupId])
  @@index([siteId])
  @@map("site_pages")
  @@schema("public")
}

/// One frozen copy of everything a visitor can read of a site, written only by
/// publish (and once by the first save of a site published before revisions
/// existed). Never updated, except by an erase of personal data, which rewrites
/// matched strings in place and sets `rewritten_at`. Rollback moves
/// `sites.published_revision_id`.
/// `document` is the SiteRevisionDocument of src/server/sites/revision.ts, one
/// JSON value so pages and components can never mix versions, read through
/// parseRevisionDocument, so a new frozen field needs no migration.
model SiteRevision {
  id String @id @default(uuid())

  siteId String @map("site_id")

  // --- hard isolation boundary (both indexed), denormalised from the Site ---
  workspaceId   String @map("workspace_id")
  tenantGroupId String @map("tenant_group_id")

  // 1, 2, 3... per site. Never reused: pruning removes only the oldest.
  number   Int
  kind     SiteRevisionKind @default(publish)
  document Json

  // The auth-brain user who published; NULL for a baseline, which nobody chose.
  publishedBy String? @map("published_by")

  createdAt DateTime @default(now()) @map("created_at")

  // When an erase of personal data last rewrote this document in place; NULL when it never did. Part of the
  // key of the expanded-page memo, since the id stays the same.
  rewrittenAt DateTime? @map("rewritten_at")

  site Site @relation("SiteRevisions", fields: [siteId], references: [id], onDelete: Cascade)

  // The sites this revision is live on: its own site, or none.
  liveOn Site[] @relation("SitePublishedRevision")

  @@unique([siteId, number])
  @@index([workspaceId])
  @@index([tenantGroupId])
  @@map("site_revisions")
  @@schema("public")
}

/// One erase of personal data from a site's history (docs/plans/2026-11-01-immutable-published-copy.md,
/// "Erasing personal data from the history"): who erased, when, and every place changed. NEVER the value,
/// an excerpt or a hash of it. No foreign key to the site on purpose, so the record outlives a site delete.
model SiteErasure {
  id String @id @default(uuid())

  siteId        String @map("site_id")
  workspaceId   String @map("workspace_id")
  tenantGroupId String @map("tenant_group_id")

  // The auth-brain user (the company's owner) who erased.
  erasedBy String @map("erased_by")

  // How many strings were rewritten, and how many matches the search found afterwards (blocked ones and
  // the ones left out included).
  erasedCount    Int @map("erased_count")
  remainingCount Int @map("remaining_count")

  // The places changed: [{ location, revision, pageId, area, path }], paths without values.
  places Json

  createdAt DateTime @default(now()) @map("created_at")

  @@index([siteId])
  @@index([workspaceId])
  @@index([tenantGroupId])
  @@map("site_erasures")
  @@schema("public")
}

/// The subdomain-by-default + custom-hostname state for a site. Two kinds of
/// row, never mixed:
///
///   - the platform subdomain row: `subdomain` set (the <label>.sites.lumitra.co
///     label), status `active`, every custom-domain column null;
///   - one row per custom domain (plan 2026-06-25-framer-custom-domains):
///     `hostname` is what the owner asked for (ASCII, punycode for IDNs, not
///     unique, so a pending claim can never block the real owner), and
///     `customHostname` is the LIVE claim, set only once DNS ownership was
///     verified and cleared when the claim is lost. The unique index on
///     `customHostname` is what makes a domain belong to exactly one site.
model SiteDomain {
  id String @id @default(uuid())

  siteId String @map("site_id")

  // --- hard isolation boundary (both indexed), denormalised from the Site ---
  workspaceId   String @map("workspace_id")
  tenantGroupId String @map("tenant_group_id")

  subdomain          String?                  @map("subdomain")
  customHostname     String?                  @map("custom_hostname")
  verificationStatus DomainVerificationStatus @default(pending) @map("verification_status")
  isPrimary          Boolean                  @default(false) @map("is_primary")

  // --- custom domains only (null on the platform subdomain row) ---
  // The hostname the owner asked for, normalized (lowercase ASCII).
  hostname            String?   @map("hostname")
  // The random token the owner publishes as TXT `_lumitra-verify.<hostname>`.
  // Minted fresh for every claim and never reused (unique across all rows).
  verificationToken   String?   @map("verification_token")
  verifiedAt          DateTime? @map("verified_at")
  activatedAt         DateTime? @map("activated_at")
  lastCheckedAt       DateTime? @map("last_checked_at")
  // Why the last check did not succeed: a stable code plus a sentence for the
  // owner. Cleared by a successful check.
  lastErrorCode       String?   @map("last_error_code")
  lastError           String?   @map("last_error")
  // Definitive routing failures in a row seen by the scheduled re-check of a
  // live domain; the claim is released at RECHECK_RELEASE_AFTER. Transient
  // DNS errors never count; any success resets it.
  consecutiveFailures Int       @default(0) @map("consecutive_failures")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // A subdomain label and a custom hostname are each globally unique (one host
  // resolves to exactly one site). Partial uniqueness (NULLs allowed many
  // times) is Postgres-default for @@unique on nullable columns.
  @@unique([subdomain])
  @@unique([customHostname])
  @@unique([verificationToken])
  @@unique([siteId, hostname])
  @@index([hostname])
  @@index([customHostname, lastCheckedAt])
  @@index([workspaceId])
  @@index([tenantGroupId])
  @@index([siteId])
  @@map("site_domains")
  @@schema("public")
}

/// A reference to an experiment configured for a site (the per-variant publish
/// + edge A/B layer is P2/P4; P1b only persists the config ref). `experimentKey`
/// is the stable key the analytics platform + the precompute permutation set
/// share; `config` carries variants/weights as authored. Scoped per site.
model SiteExperiment {
  id String @id @default(uuid())

  siteId String @map("site_id")

  // --- hard isolation boundary (both indexed), denormalised from the Site ---
  workspaceId   String @map("workspace_id")
  tenantGroupId String @map("tenant_group_id")

  experimentKey String               @map("experiment_key")
  status        SiteExperimentStatus @default(draft)

  // variants / weights / targeting as authored. Shape owned by the experiment
  // tooling (P5); persisted opaquely here.
  config Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, experimentKey])
  @@index([workspaceId])
  @@index([tenantGroupId])
  @@index([siteId])
  @@map("site_experiments")
  @@schema("public")
}

// ===========================================================================
// CMS content agent (slice4-content-agent-phase2). Records every natural-language
// agent run and its per-mutation inverses so the user can "Undo all" in one click.
// Each AgentChange stores the EXACT inverse call (`inverseTool` + `inversePayload`)
// captured read-before-write; undo replays them in reverse `position` order.
// ===========================================================================

enum AgentRunStatus {
  pending
  running
  done
  failed

  @@schema("public")
}

model AgentRun {
  id           String         @id @default(uuid())
  collectionId String         @map("collection_id")
  workspaceId  String         @map("workspace_id")
  prompt       String
  model        String
  status       AgentRunStatus @default(pending)
  errorMessage String?        @map("error_message")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  changes      AgentChange[]

  @@map("agent_runs")
  @@schema("public")
}

model AgentChange {
  id             String   @id @default(uuid())
  runId          String   @map("run_id")
  position       Int
  tool           String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  inverseTool    String   @map("inverse_tool")
  inversePayload Json     @map("inverse_payload")
  createdAt      DateTime @default(now()) @map("created_at")
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("agent_changes")
  @@schema("public")
}

/// How often a site's pages would have had one host blocked by one directive of
/// the report-only policy (src/lib/site/cspReportOnly.ts). An aggregate on
/// purpose: no visitor, page address, referrer or user agent is kept, and an
/// address is reduced to its host (src/server/sites/cspReports.ts). The rows per
/// site are capped (src/server/sites/cspReportStore.ts).
model CspReportCount {
  siteId      String   @map("site_id")
  directive   String
  blockedHost String   @map("blocked_host")
  count       Int      @default(1)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([siteId, directive, blockedHost])
  @@map("csp_report_counts")
  @@schema("public")
}

/// One write of the site operations library (src/server/siteOps): who wrote
/// (an editor user or a company API key), to which site, which operations and
/// the version it moved the site from and to. Ids and operation names only,
/// never page content, so an erase of personal data has nothing to rewrite
/// here. No foreign key on purpose: the record of what an agent did outlives
/// the site it did it to.
model SiteOperationAudit {
  id String @id @default(uuid())

  siteId        String @map("site_id")
  workspaceId   String @map("workspace_id")
  tenantGroupId String @map("tenant_group_id")

  // `user` (an auth-brain user id) or `key` (an auth-brain API key id).
  actorKind   String @map("actor_kind")
  actorId     String @map("actor_id")
  // Extra ids about the actor (a key's service account), never a secret.
  actorDetail Json?  @map("actor_detail")

  // batch, create_site, generate_page, publish, rollback.
  operation String

  // The batch's operations: [{ op, nodeId?, pageId? }].
  ops Json?

  versionBefore Int? @map("version_before")
  versionAfter  Int? @map("version_after")
  revision      Int?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([siteId, createdAt])
  @@index([workspaceId])
  @@map("site_operation_audits")
  @@schema("public")
}

/// One company erasure delivery from auth-brain (`POST /api/internal/erasure`, src/server/erasure; plan
/// docs/plans/2026-11-05-company-erasure-consumer.md). Keyed by auth-brain's event id, so a repeated
/// delivery of an erasure already done answers 2xx without deleting again. `scope` keeps what the first
/// attempt found (site ids, workspace ids, subdomains, custom hostnames), so a retry after a partial
/// failure still knows which caches to purge and which form submissions to delete once the site rows are
/// gone. Completed scopes retain site and workspace ids only; hostnames and subdomains are cleared
/// atomically with completion. The company id records which company was erased. `processed_at` stays NULL until every row and cached copy is gone.
model ErasureEvent {
  id          String    @id @map("event_id")
  kind        String
  tenantId    String    @map("tenant_id")
  scope       Json      @default("{}")
  attempts    Int       @default(0)
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@index([tenantId])
  @@map("erasure_events")
  @@schema("public")
}
