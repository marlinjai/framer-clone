// prisma/schema.prisma
//
// framer-clone backend foundation (Track 0). SINGLE file, SINGLE Postgres
// schema (NOT multiSchema). One PrismaClient serves both the CMS engine
// (the dt_* models below) and, later, the commerce engine (Track B appends
// its ~20 models onto THIS same file / datasource). Engine separation is a
// code boundary (src/server/cms vs src/server/commerce), not a DB boundary.
//
// The 8 dt_* models are copied verbatim from
//   data-table/packages/adapter-prisma/prisma/schema.prisma
// so the single generated client also serves the adapter-prisma repo that
// slice2-cms-server-adapter-and-repo wires in later.
//
// DATABASE_URL is injected via Infisical / Coolify, never a .env file and
// never a literal. The singleton in src/server/db.ts reads it lazily, so a
// placeholder value is enough for `next build`.

generator client {
  provider = "prisma-client-js"
}

// Two named schemas in ONE Postgres database (multiSchema, GA in Prisma 6):
//   public   -> the CMS engine (dt_* models, unchanged from Track 0).
//   commerce -> the owned commerce engine. b1 built the role topology around
//               a `commerce` schema (prisma/sql/commerce-roles.sql grants on
//               SCHEMA commerce; b2's append-only REVOKE targets
//               commerce.stock_movement), so the commerce tables MUST live in
//               that schema for those grants/REVOKE to mean anything. One
//               PrismaClient still serves both; multiSchema is what lets a
//               single client span the two schemas. Every model and enum now
//               carries an explicit @@schema (required once `schemas` is set).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["commerce", "public"]
}

model DtTable {
  id          String     @id @default(uuid())
  workspaceId String     @map("workspace_id")
  name        String
  description String?
  icon        String?
  migrated    Boolean    @default(false)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  columns     DtColumn[]
  views       DtView[]

  @@map("dt_tables")
  @@schema("public")
}

model DtColumn {
  id        String   @id @default(uuid())
  tableId   String   @map("table_id")
  name      String
  type      String
  position  Int
  width     Int      @default(200)
  isPrimary Boolean  @default(false) @map("is_primary")
  config    Json?
  alignment String?
  createdAt DateTime @default(now()) @map("created_at")
  table     DtTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("dt_columns")
  @@schema("public")
}

model SelectOption {
  id       String  @id @default(uuid())
  columnId String  @map("column_id")
  name     String
  color    String?
  position Int

  @@map("select_options")
  @@schema("public")
}

model DtRowSelectValue {
  id       String @id @default(uuid())
  rowId    String @map("row_id")
  columnId String @map("column_id")
  optionId String @map("option_id")

  @@unique([rowId, columnId, optionId])
  @@map("dt_row_select_values")
  @@schema("public")
}

model DtRelation {
  id             String   @id @default(uuid())
  sourceRowId    String   @map("source_row_id")
  sourceColumnId String   @map("source_column_id")
  targetRowId    String   @map("target_row_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([sourceRowId, sourceColumnId, targetRowId])
  @@map("dt_relations")
  @@schema("public")
}

model DtFile {
  id           String @id @default(uuid())
  rowId        String @map("row_id")
  columnId     String @map("column_id")
  fileId       String @map("file_id")
  fileUrl      String @map("file_url")
  originalName String @map("original_name")
  mimeType     String @map("mime_type")
  sizeBytes    Int?   @map("size_bytes")
  position     Int    @default(0)
  metadata     Json?

  @@map("dt_files")
  @@schema("public")
}

model DtView {
  id        String   @id @default(uuid())
  tableId   String   @map("table_id")
  name      String
  type      String   @default("table")
  isDefault Boolean  @default(false) @map("is_default")
  position  Int      @default(0)
  config    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  table     DtTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("dt_views")
  @@schema("public")
}

// Legacy table: kept during the migration transition period
model DtRow {
  id        String  @id @default(uuid())
  tableId   String  @map("table_id")
  cells     Json?
  computed  Json?
  title     String? @map("_title")
  archived  Int     @default(0) @map("_archived")
  createdAt String  @map("_created_at")
  updatedAt String  @map("_updated_at")

  @@map("dt_rows")
  @@schema("public")
}

// ===========================================================================
// Site persistence (P1b): the multi-tenant source of truth for the visual
// editor. Today the ProjectModel/PageModel MST tree lives only in browser
// memory; these four tables make Prisma the source of truth and the MST a
// working copy that is snapshotted in (load) and out (save).
//
// HARD ISOLATION BOUNDARY: every table here carries BOTH `workspace_id` AND
// `tenant_group_id`, and BOTH are indexed. workspace_id is the per-request
// scope every editor/API query filters by (the auth-brain consuming-app
// contract: the caller's session yields a workspace, never cross-workspace
// data). tenant_group_id is the coarser isolation boundary that keeps the
// B2B2C door open: a site can later be promoted to its own tenant_group
// without a schema change, and a tenant_group-wide query (export, deletion,
// billing) is index-backed. Neither column is a foreign key into this app:
// the tenant_group -> tenant -> workspace hierarchy is owned by auth-brain,
// framer-clone models NO identity (no users/memberships table). These ids are
// resolved from the verified session and stamped onto each row.
//
// One framer-clone "project" (a ProjectModel) == one `Site` row. Each MST
// page (PageModel) == one `SitePage` row whose `snapshot` JSON is the full
// PageModel SnapshotOut. The Lumitra Analytics binding (LumitraBindingModel)
// is denormalised onto the Site row so a publish-path read needs no JSON
// parse to find the analytics project/ingestion-key reference.
// ===========================================================================

enum SiteStatus {
  draft
  published
  archived

  @@schema("public")
}

enum DomainVerificationStatus {
  pending
  active
  failed

  @@schema("public")
}

enum SiteExperimentStatus {
  draft
  running
  paused
  completed

  @@schema("public")
}

/// A persisted framer-clone site == one ProjectModel. The MST tree is the
/// editor working copy; this row plus its `pages` is the source of truth.
model Site {
  id String @id @default(uuid())

  // --- hard isolation boundary (both indexed) ---
  workspaceId   String @map("workspace_id")
  tenantGroupId String @map("tenant_group_id")

  // --- ProjectModel.metadata snapshot ---
  name        String
  description String     @default("")
  status      SiteStatus @default(draft)

  // --- LumitraBindingModel snapshot (denormalised for the publish path) ---
  // analyticsProjectId / ingestionEndpoint / apiKeyRef mirror the MST
  // `lumitra` sub-tree. apiKeyRef is a SERVER-SIDE reference (Infisical path /
  // workspace-scoped pointer), NEVER the literal ap_live_ key. lumitraEnabled
  // gates snippet injection on publish.
  analyticsProjectId String? @map("analytics_project_id")
  ingestionEndpoint  String? @map("ingestion_endpoint")
  apiKeyRef          String? @map("api_key_ref")
  lumitraEnabled     Boolean @default(false) @map("lumitra_enabled")

  // ProjectModel.metadata timestamps are APPLICATION-meaningful (the user's
  // "created" / "last edited" shown in the UI), distinct from the row
  // timestamps below which track the persistence layer. Persisted explicitly
  // so a load -> save round-trip preserves them instead of resetting them via
  // the MST `() => new Date()` factory.
  projectCreatedAt DateTime @map("project_created_at")
  projectUpdatedAt DateTime @map("project_updated_at")

  // Persistence-layer timestamps (when the ROW was written), set by the DB.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pages       SitePage[]
  domains     SiteDomain[]
  experiments SiteExperiment[]

  @@index([workspaceId])
  @@index([tenantGroupId])
  @@map("sites")
  @@schema("public")
}

/// One serialized PageModel. `snapshot` is the full PageModel SnapshotOut
/// (metadata + appComponentTree + canvasNodes), the unit the MST loads from /
/// saves to. `pageId` is the MST page identifier (stable across saves);
/// `slug` is mirrored out of the snapshot so the publish/router layer can
/// resolve a page by URL without parsing the JSON.
model SitePage {
  id String @id @default(uuid())

  siteId String @map("site_id")

  // --- hard isolation boundary (both indexed), denormalised from the Site ---
  workspaceId   String @map("workspace_id")
  tenantGroupId String @map("tenant_group_id")

  // MST PageModel.id (the `types.identifier`). Unique within a site so a
  // save can upsert per page rather than delete-and-recreate.
  pageId String @map("page_id")
  slug   String

  // Full PageModel SnapshotOut. Json (not Jsonb-via-bytes) so it stays
  // human-readable in psql and the page tree round-trips losslessly.
  snapshot Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, pageId])
  @@index([workspaceId])
  @@index([tenantGroupId])
  @@index([siteId])
  @@map("site_pages")
  @@schema("public")
}

/// The subdomain-by-default + custom-hostname state for a site. Edge hosting
/// (P3) consumes this; P1b only persists it. `subdomain` is the
/// <name>.framer-host zone label; `customHostname` is the connected apex/www
/// the site owner points at us (Cloudflare for SaaS custom hostname, verified
/// out of band). One active custom hostname per row.
model SiteDomain {
  id String @id @default(uuid())

  siteId String @map("site_id")

  // --- hard isolation boundary (both indexed), denormalised from the Site ---
  workspaceId   String @map("workspace_id")
  tenantGroupId String @map("tenant_group_id")

  subdomain          String?                  @map("subdomain")
  customHostname     String?                  @map("custom_hostname")
  verificationStatus DomainVerificationStatus @default(pending) @map("verification_status")
  isPrimary          Boolean                  @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // A subdomain label and a custom hostname are each globally unique (one host
  // resolves to exactly one site). Partial uniqueness (NULLs allowed many
  // times) is Postgres-default for @@unique on nullable columns.
  @@unique([subdomain])
  @@unique([customHostname])
  @@index([workspaceId])
  @@index([tenantGroupId])
  @@index([siteId])
  @@map("site_domains")
  @@schema("public")
}

/// A reference to an experiment configured for a site (the per-variant publish
/// + edge A/B layer is P2/P4; P1b only persists the config ref). `experimentKey`
/// is the stable key the analytics platform + the precompute permutation set
/// share; `config` carries variants/weights as authored. Scoped per site.
model SiteExperiment {
  id String @id @default(uuid())

  siteId String @map("site_id")

  // --- hard isolation boundary (both indexed), denormalised from the Site ---
  workspaceId   String @map("workspace_id")
  tenantGroupId String @map("tenant_group_id")

  experimentKey String               @map("experiment_key")
  status        SiteExperimentStatus @default(draft)

  // variants / weights / targeting as authored. Shape owned by the experiment
  // tooling (P5); persisted opaquely here.
  config Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, experimentKey])
  @@index([workspaceId])
  @@index([tenantGroupId])
  @@index([siteId])
  @@map("site_experiments")
  @@schema("public")
}

// ===========================================================================
// CMS content agent (slice4-content-agent-phase2). Records every natural-language
// agent run and its per-mutation inverses so the user can "Undo all" in one click.
// Each AgentChange stores the EXACT inverse call (`inverseTool` + `inversePayload`)
// captured read-before-write; undo replays them in reverse `position` order.
// ===========================================================================

enum AgentRunStatus {
  pending
  running
  done
  failed

  @@schema("public")
}

model AgentRun {
  id           String         @id @default(uuid())
  collectionId String         @map("collection_id")
  workspaceId  String         @map("workspace_id")
  prompt       String
  model        String
  status       AgentRunStatus @default(pending)
  errorMessage String?        @map("error_message")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  changes      AgentChange[]

  @@map("agent_runs")
  @@schema("public")
}

model AgentChange {
  id             String   @id @default(uuid())
  runId          String   @map("run_id")
  position       Int
  tool           String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  inverseTool    String   @map("inverse_tool")
  inversePayload Json     @map("inverse_payload")
  createdAt      DateTime @default(now()) @map("created_at")
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("agent_changes")
  @@schema("public")
}

// ===========================================================================
// Commerce engine: owned inventory ledger (b2). FIRST commerce schema writer.
//
// The event-sourced inventory ledger, purpose-built Prisma (NOT data-table).
// stock_movement is the APPEND-ONLY source of truth; inventory_level is its
// projection. Oversell is made structurally impossible at the schema level by:
//   - a GENERATED STORED column available_quantity = stocked - reserved
//     (added via raw-SQL migration; Prisma cannot express generated columns),
//   - a CHECK (reserved_quantity <= stocked_quantity) backstop (raw-SQL),
//   - non-negativity floor CHECKs (stocked_quantity >= 0, reserved_quantity >= 0,
//     raw-SQL) so negative pairs cannot mint phantom available stock,
//   - the append-only REVOKE UPDATE,DELETE ON stock_movement FROM commerce_app
//     (raw-SQL, using the b1 role topology),
//   - a `version` Int for optimistic concurrency,
//   - the composite UNIQUE (inventory_item_id, location_id),
//   - a partial-unique sku WHERE deleted_at IS NULL (raw-SQL) so a SKU frees on
//     soft-delete.
// Write logic / reservation guards / the guarded decrement are b3, NOT here.
// ===========================================================================

enum StockMovementType {
  receive
  reserve
  release
  fulfill
  adjust
  transfer

  @@schema("commerce")
}

model InventoryItem {
  id        String    @id @default(uuid())
  sku       String
  title     String?
  // Physical dimensions (nullable; integer minor units: mm and grams).
  lengthMm  Int?      @map("length_mm")
  widthMm   Int?      @map("width_mm")
  heightMm  Int?      @map("height_mm")
  weightG   Int?      @map("weight_g")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  levels    InventoryLevel[]
  movements StockMovement[]

  // sku is NOT a plain @@unique here on purpose: a partial-unique index
  // (UNIQUE WHERE deleted_at IS NULL) is added in the raw-SQL migration so the
  // SKU frees on soft-delete. Prisma cannot express partial unique indexes.
  @@map("inventory_item")
  @@schema("commerce")
}

model StockLocation {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  levels              InventoryLevel[]
  movements           StockMovement[]
  reservations        Reservation[]
  fulfillmentDefaults FulfillmentLocationDefault[]

  @@map("stock_location")
  @@schema("commerce")
}

// Per-workspace default fulfillment location (b3). When a reservation omits an
// explicit locationId, resolveLocation reads the default for the workspace from
// this table; NO reservation is ever created without a concrete location. v1
// ships ONE constant workspace, so this table normally holds a single row, but
// it is keyed by workspace_id so E7 multi-tenancy needs no shape change. The
// deferred transfer-balance trigger ships in the same migration (raw SQL,
// Prisma cannot express a CONSTRAINT TRIGGER).
model FulfillmentLocationDefault {
  workspaceId String   @id @map("workspace_id")
  locationId  String   @map("location_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@map("fulfillment_location_default")
  @@schema("commerce")
}

model InventoryLevel {
  id               String   @id @default(uuid())
  inventoryItemId  String   @map("inventory_item_id")
  locationId       String   @map("location_id")
  stockedQuantity  Int      @default(0) @map("stocked_quantity")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  // !!! GENERATED-COLUMN DRIFT GUARD: DO NOT add available_quantity here. !!!
  // available_quantity is a GENERATED ALWAYS AS (stocked - reserved) STORED
  // column added in the raw-SQL migration. It is intentionally ABSENT from this
  // model: Prisma has no representation for generated columns, and a row read
  // here must never let the app write it. b7 (REST reads) exposes it; it is
  // DB-filterable today.
  //
  // Because the column is absent here but present in the database, the next
  // `prisma migrate dev` WILL detect drift and PROPOSE a destructive
  //   ALTER TABLE "commerce"."inventory_level" DROP COLUMN "available_quantity";
  // in the generated migration. That DROP MUST be deleted from any generated
  // migration before applying it: it would remove the structural oversell
  // guarantee and break every available-quantity read. The same applies to the
  // three CHECK constraints (reserved <= stocked, stocked >= 0, reserved >= 0),
  // which Prisma also cannot express and which migrate dev may likewise try to
  // drop. See the matching warning in the migration header.
  version          Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  location      StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([inventoryItemId, locationId])
  @@map("inventory_level")
  @@schema("commerce")
}

model StockMovement {
  id              String            @id @default(uuid())
  inventoryItemId String            @map("inventory_item_id")
  locationId      String            @map("location_id")
  movementType    StockMovementType @map("movement_type")
  quantity        Int
  requestId       String            @unique @map("request_id")
  refType         String?           @map("ref_type")
  refId           String?           @map("ref_id")
  transferGroupId String?           @map("transfer_group_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  // No updatedAt: the ledger is immutable. UPDATE/DELETE are revoked from
  // commerce_app in the raw-SQL migration, enforcing append-only at the DB.
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  location      StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, locationId])
  @@map("stock_movement")
  @@schema("commerce")
}

model Reservation {
  id         String   @id @default(uuid())
  // line_item_id references a future order line item (b6 orders): nullable, no
  // FK yet.
  lineItemId String?  @map("line_item_id")
  locationId String   @map("location_id")
  quantity   Int
  requestId  String   @unique @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@map("reservation")
  @@schema("commerce")
}

// ===========================================================================
// Commerce engine: owned catalog (b4). Serial schema position: after b3
// (guarded reservation), before b5 (pricing + tax). The purpose-built typed
// catalog (product / option / option_value / variant + the variant<->option
// matrix). Catalog CONTENT only: NO price (b5), NO inventory linkage (b2/b3),
// NO Yjs (deferred E5).
//
// Two correctness-closing must-fixes live at the database level here:
//   (1) the COMPOSITE FK on product_variant_option
//       (option_value_id, option_id) -> product_option_value(id, option_id),
//       so the DB REJECTS a variant option whose option_id does not match the
//       option_value's real option. The FK target is the @@unique([id, optionId])
//       on product_option_value below.
//   (2) the option_signature BEFORE INSERT/UPDATE trigger (raw-SQL migration)
//       that recomputes a variant's signature by sorting its option_value_ids
//       from product_variant_option, plus a partial-UNIQUE on that signature so
//       no two LIVE variants of a product can share an option combination.
//
// !!! TRIGGER-MAINTAINED-COLUMN DRIFT WARNING (read before `prisma migrate dev`) !!!
// product_variant.option_signature is INTENTIONALLY ABSENT from this model: it is
// a trigger-maintained column (BEFORE INSERT/UPDATE), added via the raw-SQL
// migration together with its partial-UNIQUE index, because Prisma has no
// datamodel representation for a trigger-computed column. As with the b2 generated
// available_quantity column, the NEXT `prisma migrate dev` will detect it as drift
// and PROPOSE a destructive
//   ALTER TABLE "commerce"."product_variant" DROP COLUMN "option_signature";
// in the generated migration. That DROP MUST be deleted before applying: it would
// remove the no-duplicate-combination guarantee and break the signature trigger.
// All partial-unique indexes below (handle, (product_id,title), (option_id,value),
// sku, barcode, option_signature) are likewise raw SQL and must not be dropped.
// ===========================================================================

enum ProductStatus {
  draft
  published

  @@schema("commerce")
}

model Product {
  id          String        @id @default(uuid())
  title       String
  handle      String
  description String?
  status      ProductStatus @default(draft)
  // taxClass (b5): the CATALOG-side tax CLASSIFICATION only (e.g. a
  // product-tax-code string a future bought tax engine maps to a rate). It is
  // NOT a tax rate and NOT an Order-level field (tax_region / vat_id /
  // reverse_charge / net_or_gross / kleinunternehmer all live on the Order model
  // b6 creates). Nullable: an unset product inherits the engine's default class.
  taxClass    String?       @map("tax_class")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  options  ProductOption[]
  variants ProductVariant[]

  // handle is NOT a plain @@unique: a partial-unique index (UNIQUE WHERE
  // deleted_at IS NULL) is added in the raw-SQL migration so a handle frees on
  // soft-delete. Prisma cannot express partial unique indexes.
  @@map("product")
  @@schema("commerce")
}

model ProductOption {
  id        String    @id @default(uuid())
  productId String    @map("product_id")
  title     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  // unique (product_id, title) among LIVE rows: partial index in the raw-SQL
  // migration (frees on soft-delete).
  @@map("product_option")
  @@schema("commerce")
}

model ProductOptionValue {
  id        String    @id @default(uuid())
  optionId  String    @map("option_id")
  value     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  option         ProductOption          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantOptions ProductVariantOption[]

  // unique (option_id, value) among LIVE rows: partial index in the raw-SQL
  // migration (frees on soft-delete).
  //
  // @@unique([id, optionId]) is the COMPOSITE-FK TARGET (must-fix 1): it lets
  // product_variant_option carry a composite FK (option_value_id, option_id) ->
  // (id, option_id), so the database REJECTS an option_value paired with the
  // wrong option_id. id alone is already unique (it is the @id); this extra
  // tuple-unique exists solely to be a valid multi-column FK reference target.
  @@unique([id, optionId])
  @@map("product_option_value")
  @@schema("commerce")
}

model ProductVariant {
  id        String    @id @default(uuid())
  productId String    @map("product_id")
  title     String?
  sku       String?
  barcode   String?
  // taxClass (b5): per-variant CATALOG-side tax classification override. A
  // variant whose taxClass is NULL falls back to its product's taxClass at
  // resolution time (the resolution itself is the bought tax engine's job, E8).
  // Same constraint as Product.taxClass: a classification string, never a rate,
  // never an Order-level tax field.
  taxClass  String?   @map("tax_class")
  // option_signature is INTENTIONALLY ABSENT (see the drift warning above): a
  // trigger-maintained, partial-UNIQUE column added in the raw-SQL migration.
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product  Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  options  ProductVariantOption[]
  // priceSet (b5): a variant has at most ONE price_set (the container its
  // currency/quantity-scoped prices hang off). Back-relation for PriceSet.variantId.
  priceSet PriceSet?

  // sku and barcode are each partial-unique among LIVE rows: partial indexes in
  // the raw-SQL migration (each frees on soft-delete).
  @@map("product_variant")
  @@schema("commerce")
}

model ProductVariantOption {
  variantId     String @map("variant_id")
  optionId      String @map("option_id")
  optionValueId String @map("option_value_id")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // The COMPOSITE FK (must-fix 1): (option_value_id, option_id) must be a real
  // (id, option_id) pair in product_option_value, so an option_value can never be
  // attached under the wrong option_id. option_id's referential validity flows
  // transitively from product_option_value.option_id -> product_option.id, so no
  // separate option FK is needed here.
  optionValue ProductOptionValue @relation(fields: [optionValueId, optionId], references: [id, optionId], onDelete: Restrict)

  // PK (variant_id, option_id): exactly ONE value per option per variant.
  @@id([variantId, optionId])
  @@map("product_variant_option")
  @@schema("commerce")
}

// ===========================================================================
// Commerce engine: pricing graph + catalog-side tax_class + corrective-invoice
// entity (b5). Serial schema position: after b4 (catalog), before b6 (orders).
//
// Money is ALWAYS an integer in minor units (cents), NEVER a float and NEVER
// Yjs: every monetary column below is `Int` (amount in cents), so a price can
// neither acquire a rounding error in the database nor drift through the
// realtime layer. The resolver (src/server/commerce/repository/pricing.ts)
// reads these rows over a tx and returns integer cents unchanged: no float math
// is performed anywhere on the path.
//
// b5 owns ONLY: the pricing graph (price_set / price / price_rule / price_list),
// the CATALOG-side tax_class (added above on Product/ProductVariant), and the
// CreditNote (Storno/Gutschrift) + credit_note_ref corrective-invoice entity.
// b5 adds NO Order.* fields and creates NO Order model: the order-level tax
// fields (tax_region / vat_id / customer_type / reverse_charge / net_or_gross /
// kleinunternehmer) and the Order model itself are OWNED by b6. The bought
// tax-engine call, OSS accumulation, and invoice rendering are E8.
// ===========================================================================

// price_list.status: a draft list is invisible to resolution; only an `active`
// list (within its optional date window) contributes prices.
enum PriceListStatus {
  draft
  active

  @@schema("commerce")
}

// price_list.type: an `override` list replaces the base price; a `sale` list is
// a (typically lower) promotional price. Resolution prefers a price-list price
// over the base price regardless of type; type is carried for downstream display
// / reporting (b7) and does not change which row wins here.
enum PriceListType {
  override
  sale

  @@schema("commerce")
}

// price_set (pset): the container a variant's prices hang off. Exactly one per
// variant (variant_id is UNIQUE), nullable so a price_set can be staged before
// it is attached to a variant. The variant -> price_set -> price chain is the
// path resolvePrice walks.
model PriceSet {
  id        String   @id @default(uuid())
  variantId String?  @unique @map("variant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  prices  Price[]

  @@map("price_set")
  @@schema("commerce")
}

// price (price): one priced row. amount is integer minor units (cents), NEVER a
// float. Belongs to a price_set and OPTIONALLY to a price_list (price_list_id
// NULL = the base price). min/max_quantity scope the price to a quantity band
// (NULL = unbounded on that side), enabling quantity-break pricing.
model Price {
  id           String   @id @default(uuid())
  priceSetId   String   @map("price_set_id")
  priceListId  String?  @map("price_list_id")
  currencyCode String   @map("currency_code")
  // amount: integer minor units (cents). Int, so the database physically cannot
  // store a fractional amount; resolvePrice returns this value unchanged.
  amount       Int
  minQuantity  Int?     @map("min_quantity")
  maxQuantity  Int?     @map("max_quantity")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  priceSet  PriceSet    @relation(fields: [priceSetId], references: [id], onDelete: Cascade)
  priceList PriceList?  @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  rules     PriceRule[]

  @@index([priceSetId, currencyCode])
  @@map("price")
  @@schema("commerce")
}

// price_rule (prule): an attribute-based predicate attached to a price
// (attribute/value/operator with a priority for tie-breaking). The rule
// evaluation engine is downstream; b5 lands the storage shape only.
model PriceRule {
  id        String   @id @default(uuid())
  priceId   String   @map("price_id")
  attribute String
  value     String
  operator  String   @default("eq")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  price Price @relation(fields: [priceId], references: [id], onDelete: Cascade)

  @@index([priceId])
  @@map("price_rule")
  @@schema("commerce")
}

// price_list (plist): a named set of prices with a status and an optional
// active window. Only an `active` list within [starts_at, ends_at] contributes
// to resolution.
model PriceList {
  id        String          @id @default(uuid())
  title     String?
  status    PriceListStatus @default(draft)
  type      PriceListType   @default(override)
  startsAt  DateTime?       @map("starts_at")
  endsAt    DateTime?       @map("ends_at")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  prices Price[]

  @@map("price_list")
  @@schema("commerce")
}

// credit_note (Storno / Gutschrift): the corrective-invoice entity. A German
// invoice can NEVER be DELETEd: a mistake is corrected by issuing a credit note
// that references the corrected document, not by erasing the original. b5 builds
// the entity and the no-DELETE contract (the raw-SQL REVOKE UPDATE, DELETE in
// the migration makes a credit_note itself immutable for ordinary application
// traffic, the same append-only pattern b2 applied to stock_movement).
//
// correctedRef is a LOOSE reference to the corrected Order/invoice: b5 does not
// own the Order model, so the hard FK is DEFERRED to b6 (which creates Order and
// finalizes the FK). amount is integer minor units (cents), never a float.
model CreditNote {
  id           String   @id @default(uuid())
  // correctedRef: loose ref to the corrected Order/invoice id. Retained as the
  // human/audit carrier; the HARD FK is `orderId` below, FINALIZED by b6.
  correctedRef String?  @map("corrected_ref")
  // orderId (b6 finalization): the hard FK to the corrected Order/invoice. b5
  // could not express it because it does not own the Order model; b6 owns Order
  // and wires it here. Nullable so a credit note can still be staged before its
  // target Order exists. onDelete: Restrict mirrors the no-DELETE-on-invoice
  // contract: an Order that a credit note corrects can never be erased.
  orderId      String?  @map("order_id")
  reason       String?
  currencyCode String   @map("currency_code")
  amount       Int
  createdAt    DateTime @default(now()) @map("created_at")

  order Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refs  CreditNoteRef[]

  @@index([orderId])
  @@map("credit_note")
  @@schema("commerce")
}

// credit_note_ref: the junction tying a credit note to the document(s) it
// corrects. refType / refId is a loose (type, id) pair (e.g. ('order', <id>))
// rather than a hard FK, because the corrected document (Order/invoice) is owned
// by b6; b6 finalizes the FK to Order. A credit note can reference more than one
// document, hence a junction rather than a single column.
model CreditNoteRef {
  id           String   @id @default(uuid())
  creditNoteId String   @map("credit_note_id")
  refType      String   @map("ref_type")
  refId        String   @map("ref_id")
  createdAt    DateTime @default(now()) @map("created_at")

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([refType, refId])
  @@map("credit_note_ref")
  @@schema("commerce")
}

// ===========================================================================
// Commerce engine: minimal orders (b6). Serial schema position: LAST in the
// commerce schema chain (after b5). b6 OWNS the Order + OrderLineItem models,
// INCLUDING the order-level German tax model, and finalizes the b5
// CreditNote -> Order FK (above).
//
// SNAPSHOT, NOT REFERENCE: an order line copies the variant's title/sku, the
// resolved unit_price (integer cents), the quantity, and the FULL tax treatment
// (applied tax_class, resolved rate, tax_amount in cents, tax_treatment
// discriminator) AT CREATION. A later price/catalog change therefore can NEVER
// alter a placed order, and a reprint reproduces the original legal invoice with
// ZERO recomputation. The variant linkage is a LOOSE (variant_ref,
// variant_ref_source) carrier (none | datatable | owned, NEVER medusa), not a
// hard FK, so an owned-catalog variant and a future data-table-backed variant
// both fit without a schema change.
//
// MONEY IS INTEGER CENTS, ALWAYS: every monetary column (unit_price, subtotal,
// tax_amount, total) is Int (minor units), and the b6 migration applies the b5
// non-negative money floor CHECK to each. tax_rate is integer BASIS POINTS
// (1900 = 19.00%), so no float/rounding error can enter the database. Totals are
// SERVER-COMPUTED in createOrder (never client-trusted).
//
// NO-DELETE-ON-INVOICE: the b6 migration REVOKEs UPDATE, DELETE on order and
// order_line_item from commerce_app (the same append-only pattern b2 applied to
// stock_movement and b5 applied to credit_note): a placed order/invoice is a
// permanent accounting record, corrected only by a CreditNote, never erased.
// ===========================================================================

// order.status: a freshly placed order is `confirmed` (its stock is reserved
// inside the same atomic transaction). `pending`/`cancelled` are reserved for
// later lifecycle work; v1 createOrder writes `confirmed`.
enum OrderStatus {
  pending
  confirmed
  cancelled

  @@schema("commerce")
}

// order.customer_type: drives the German tax treatment. A B2B order with a VAT
// id in another EU member state is the reverse_charge case; B2C is the default.
enum CustomerType {
  b2c
  b2b

  @@schema("commerce")
}

// order.net_or_gross: whether the resolved unit prices are interpreted as NET
// (tax added on top) or GROSS (tax extracted from within). Default net.
enum NetOrGross {
  net
  gross

  @@schema("commerce")
}

// order_line_item.variant_ref_source: where the loose variant_ref points. NEVER
// `medusa` (the owned engine has no Medusa coupling). `none` = no carrier.
enum VariantRefSource {
  none
  datatable
  owned

  @@schema("commerce")
}

// order_line_item.tax_treatment (b5 TAX-04): the FULL discriminator a reprint
// needs, snapshotted per line. `reverse_charge` and `kleinunternehmer` both
// resolve to a zero tax_amount but carry DIFFERENT legal meaning, so they are
// distinct from a plain `zero`-rated line.
enum TaxTreatment {
  standard
  reduced
  zero
  reverse_charge
  kleinunternehmer

  @@schema("commerce")
}

model Order {
  id           String      @id @default(uuid())
  // order_number: a monotonic per-tenant invoice number, allocated from the
  // commerce.order_number_seq sequence (concurrency-safe, unlike a COUNT).
  orderNumber  String      @unique @map("order_number")
  // request_id: the ORDER-level idempotency key. A duplicate createOrder with
  // the same request_id returns the prior order (sequential pre-check) or
  // recovers the winner after a concurrent UNIQUE(request_id) race (createOrder
  // replicates b3's fresh-transaction re-read at the order level).
  requestId    String      @unique @map("request_id")
  status       OrderStatus @default(confirmed)
  currencyCode String      @map("currency_code")

  // --- order-level German tax model (OWNED by b6) ---
  taxRegion        String       @map("tax_region")
  vatId            String?      @map("vat_id")
  customerType     CustomerType @default(b2c) @map("customer_type")
  reverseCharge    Boolean      @default(false) @map("reverse_charge")
  netOrGross       NetOrGross   @default(net) @map("net_or_gross")
  kleinunternehmer Boolean      @default(false)
  // tax_note: the legal notice text set when VAT is suppressed (the reverse
  // charge Section 13b notice, or the Kleinunternehmer Section 19 notice). NULL
  // for an ordinary taxed order.
  taxNote          String?      @map("tax_note")

  // --- server-computed integer-cents totals (NEVER client-trusted) ---
  subtotal  Int // sum of line net amounts (cents)
  taxAmount Int @map("tax_amount") // sum of line tax amounts (cents)
  total     Int // subtotal + taxAmount (cents)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lineItems   OrderLineItem[]
  creditNotes CreditNote[]

  @@map("order")
  @@schema("commerce")
}

model OrderLineItem {
  id      String @id @default(uuid())
  orderId String @map("order_id")

  // --- snapshot (NOT reference) ---
  variantTitle String? @map("variant_title")
  variantSku   String? @map("variant_sku")
  unitPrice    Int     @map("unit_price") // resolved unit price (cents) at creation
  quantity     Int
  subtotal     Int // line net amount (cents): the b5 money floor applies

  // --- full tax treatment snapshot (b5 TAX-04) ---
  taxClass     String?      @map("tax_class") // applied catalog tax class, snapshotted
  taxRate      Int          @map("tax_rate") // integer BASIS POINTS (1900 = 19%)
  taxAmount    Int          @map("tax_amount") // line tax (cents)
  taxTreatment TaxTreatment @map("tax_treatment")

  // --- loose variant carrier (none | datatable | owned, NEVER medusa) ---
  variantRef       String?          @map("variant_ref")
  variantRefSource VariantRefSource @default(none) @map("variant_ref_source")

  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_line_item")
  @@schema("commerce")
}
