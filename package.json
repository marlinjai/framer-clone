{
  "name": "framer-clone",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm fonts:sync && TZ=UTC next dev",
    "build": "pnpm fonts:sync && next build",
    "harness:books-engine": "pnpm fonts:sync && BOOKS_ENGINE_HARNESS=1 next build && BOOKS_ENGINE_HARNESS=1 EDITOR_HOST=localhost TZ=UTC next start -p 3917",
    "bench:preview": "esbuild scripts/bench-template-preview.ts --bundle --platform=node --target=node22 --format=cjs --log-level=warning --outfile=dist-bench/bench-template-preview.cjs && docker run --rm --platform linux/arm64 -e NODE_ENV=production -e TZ=UTC -v \"$PWD/dist-bench:/app/dist-bench:ro\" -v \"$PWD/assets:/app/assets:ro\" -w /app node:22.23-bookworm-slim node dist-bench/bench-template-preview.cjs",
    "build:boot": "esbuild scripts/commerce-migrate.ts --bundle --platform=node --target=node22 --format=cjs --log-level=warning --outfile=dist-boot/commerce-migrate.cjs",
    "start": "next start",
    "fonts:sync": "tsx scripts/sync-fonts.ts",
    "lint": "eslint .",
    "lint:guards": "node scripts/check-guards.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:public": "tsx scripts/db-public.ts",
    "db:migrate-tenants": "tsx scripts/db-migrate-tenants.ts",
    "db:backfill-demo": "tsx scripts/db-backfill-demo.ts",
    "db:codegen-commerce": "tsx scripts/commerce-codegen.ts",
    "books:init-company": "tsx scripts/books-init-company.ts",
    "catalogue:assign-company": "tsx scripts/catalogue-assign-company.ts",
    "books:import": "tsx scripts/books-import.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "docs:dev": "clearify dev",
    "docs:build": "clearify build",
    "check:roadmap": "npx --yes github:marlinjai/actions-shared#roadmap-check-v1 --root .",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
