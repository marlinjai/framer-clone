# Excludes files from the Docker build context so the image stays small and free
# of secrets.

# dependencies and build artifacts (rebuilt in the deps/builder stages)
node_modules
**/node_modules
.pnp
.pnp.*

# Next.js outputs (regenerated by `pnpm build` in the builder stage)
.next
out
build
.turbo

# coverage and test outputs
coverage
**/*.tsbuildinfo
next-env.d.ts

# env files: secrets come from Infisical at runtime, never from the image
.env
.env.*
!.env.example
.infisical.json

# git / editor / OS noise
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.DS_Store
*.swp
*.pem

# docs (Clearify) + deploy runbook are not needed at runtime
docs
deploy

# test sources are not needed at runtime
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__
**/*.itest.ts
test
vitest.config.ts
vitest.integration.config.ts
vitest.integration.setup.ts

# log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# claude / orchestrator state
.claude
.worktrees
